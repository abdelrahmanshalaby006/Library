@model LendViewModel
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Lend a book";
}
<div class="admin-page-head">
    <h1>Lend a book</h1>
    <p>Use this when a member takes a book straight from the desk, without an online request.</p>
</div>

<div class="panel form-panel">
    <div class="panel-body">
        <div class="toast-alert ok mb-4" style="background:var(--paper-2);color:var(--ink-soft);border-color:var(--line)">
            <span class="toast-icon">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 8v.01M11 12h1v4h1" /></svg>
            </span>
            <span>@LibraryRules.LoanDays days per loan · @LibraryRules.FinePerDay @LibraryRules.Currency per late day · max @LibraryRules.MaxOpenLoans open loans per member. Only active members and books with copies on the shelf are listed.</span>
        </div>

        <form method="post" asp-controller="AdminBorrowings" asp-action="Lend">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            <div class="mb-3">
                <label asp-for="MemberId" class="form-label"></label>
                <select asp-for="MemberId" class="form-select">
                    <option value="0">— Choose a member —</option>
                    @foreach (var m in (List<Member>)ViewBag.Members)
                    {
                        <option value="@m.Id">@m.MembershipNumber — @m.FullName</option>
                    }
                </select>
                <span asp-validation-for="MemberId" class="text-danger"></span>
            </div>
            <div class="mb-4">
                <label asp-for="BookId" class="form-label"></label>
                <select asp-for="BookId" class="form-select">
                    <option value="0">— Choose a book —</option>
                    @foreach (var b in (List<Book>)ViewBag.Books)
                    {
                        <option value="@b.Id">@b.Title — @b.Author (@b.AvailableCopies available)</option>
                    }
                </select>
                <span asp-validation-for="BookId" class="text-danger"></span>
            </div>
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-ink">Lend this book</button>
                <a class="btn btn-ghost" href="/admin/borrowings">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
