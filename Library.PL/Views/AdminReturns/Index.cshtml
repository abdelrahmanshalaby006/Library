@model List<Borrowing>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Returns";
    string filter = ViewBag.Filter ?? "active";
}
<div class="admin-page-head">
    <h1>Returns desk</h1>
    <p>Confirm returned books, collect late fees and keep the shelves accurate.</p>
</div>

<div class="filter-tabs">
    <a class="filter-tab @(filter == "active" ? "active" : "")" href="/admin/returns">On loan</a>
    <a class="filter-tab @(filter == "overdue" ? "active" : "")" href="/admin/returns?filter=overdue">Overdue</a>
    <a class="filter-tab @(filter == "fines" ? "active" : "")" href="/admin/returns?filter=fines">Unpaid fines</a>
    <a class="filter-tab @(filter == "returned" ? "active" : "")" href="/admin/returns?filter=returned">Returned</a>
</div>

<div class="panel">
    @if (Model.Count == 0)
    {
        <div class="panel-body">
            <div class="empty-state">
                <div class="empty-icon">
                    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h11a4 4 0 0 1 0 8H7" /><path d="m6 6-3 3 3 3" /></svg>
                </div>
                <h4>Nothing to hand back</h4>
                <p>No records match this view right now.</p>
            </div>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>Book</th><th>Member</th><th>Due date</th><th>Returned</th><th>Status</th><th>Fine</th><th style="width:260px"></th></tr>
                </thead>
                <tbody>
                @foreach (var b in Model)
                {
                    <tr>
                        <td>
                            <div class="cell-book">
                                <span class="mini-cover cover-tone-@(Math.Abs(b.BookId) % 7)">@b.Book.Title.Substring(0, 1).ToUpper()</span>
                                <div>
                                    <div class="cell-title">@b.Book.Title</div>
                                    <div class="muted" style="font-size:.76rem">@b.Book.Author</div>
                                </div>
                            </div>
                        </td>
                        <td><a asp-controller="AdminMembers" asp-action="Details" asp-route-id="@b.MemberId">@b.Member.FullName</a></td>
                        <td class="num">@(b.DueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td class="num">@(b.ReturnedAt?.ToString("dd MMM yyyy") ?? "—")</td>
                        <td><partial name="_BorrowingStatusPartial" model="b" /></td>
                        <td><partial name="_FinePartial" model="b" /></td>
                        <td class="text-end">
                            @if (b.Status == BorrowingStatus.Borrowed)
                            {
                                <form method="post" asp-controller="AdminReturns" asp-action="Return" asp-route-id="@b.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-soft-ok">Confirm return</button>
                                </form>
                            }
                            @if (b.FineStatus == FineStatus.Unpaid)
                            {
                                <form method="post" asp-controller="AdminReturns" asp-action="PayFine" asp-route-id="@b.Id" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-amber">Fine paid (cash)</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>

<p class="muted mt-3" style="font-size:.8rem">
    A late fee of @LibraryRules.FinePerDay @LibraryRules.Currency per day is calculated automatically when a book is returned.
    Copies return to the shelf the moment the return is confirmed.
</p>
