@model List<BookRowViewModel>
@{
    ViewData["Title"] = "Books";
    var categories = ViewBag.Categories as List<Category> ?? new List<Category>();
    var search = ViewBag.Search as string;
    int? categoryId = ViewBag.CategoryId as int?;
    var activeCategory = categoryId.HasValue ? categories.FirstOrDefault(c => c.Id == categoryId.Value) : null;
}
<div class="page-head">
    <span class="eyebrow">Catalogue</span>
    <h1>Every book in the building</h1>
    <p>Search the shelves, filter by collection, and open a title to check availability before you visit.</p>
</div>

<form method="get" class="filter-panel">
    <div class="row g-2 align-items-end">
        <div class="col-lg-6">
            <label class="form-label" for="search">Search</label>
            <input id="search" type="text" name="search" value="@search" class="form-control" placeholder="Title or author…" />
        </div>
        <div class="col-lg-4">
            <label class="form-label" for="categoryId">Collection</label>
            <select id="categoryId" name="categoryId" class="form-select">
                <option value="">All collections</option>
                @foreach (var cat in categories)
                {
                    if (categoryId == cat.Id)
                    {
                        <option value="@cat.Id" selected>@cat.Name</option>
                    }
                    else
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                }
            </select>
        </div>
        <div class="col-lg-2 d-flex gap-2">
            <button class="btn btn-ink flex-grow-1 justify-content-center" type="submit">Search</button>
            @if (!string.IsNullOrWhiteSpace(search) || categoryId.HasValue)
            {
                <a class="btn btn-outline-ink" href="/books" title="Clear filters">Reset</a>
            }
        </div>
    </div>
</form>

<div class="result-line">
    <span>
        <strong style="color:var(--ink)">@Model.Count</strong>
        @(Model.Count == 1 ? "title" : "titles")
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <text> matching “@search”</text>
        }
        @if (activeCategory != null)
        {
            <text> in @activeCategory.Name</text>
        }
    </span>
    @if (!string.IsNullOrWhiteSpace(search) || categoryId.HasValue)
    {
        <a href="/books" class="muted" style="font-size:.82rem">Clear all filters</a>
    }
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <div class="empty-icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4 4" /></svg>
        </div>
        <h4>No books matched</h4>
        <p>Try a shorter search term, or clear the filters to see everything on the shelves.</p>
        <a class="btn btn-sm btn-ink mt-3" href="/books">Reset the catalogue</a>
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var item in Model)
        {
            <div class="col-sm-6 col-lg-4 col-xl-3">
                <partial name="_BookCardPartial" model="item" />
            </div>
        }
    </div>
}
