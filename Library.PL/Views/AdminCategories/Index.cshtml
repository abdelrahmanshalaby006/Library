@model List<Category>
@{
    Layout = "_AdminLayout";
    ViewData["Title"] = "Categories";
}
<div class="admin-page-head d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <h1>Collections</h1>
        <p>@Model.Count collections used to organise the catalogue.</p>
    </div>
    <a class="btn btn-sm btn-ink" href="/admin/categories/create">+ Add collection</a>
</div>

<div class="panel" style="max-width:640px">
    @if (Model.Count == 0)
    {
        <div class="panel-body">
            <p class="muted mb-0" style="font-size:.88rem">No collections yet. Add one before cataloguing books.</p>
        </div>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th style="width:80px">#</th><th>Name</th><th style="width:120px"></th></tr></thead>
                <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="num">@item.Id</td>
                        <td class="cell-strong">@item.Name</td>
                        <td class="text-end"><a class="btn btn-sm btn-ghost" href="/books?categoryId=@item.Id">View in catalogue</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
