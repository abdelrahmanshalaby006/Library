@{
    ViewData["Title"] = "Error";
}
<div class="empty-state" style="margin-top:2rem">
    <div class="empty-icon" style="background:var(--danger-soft);color:var(--danger)">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9" /><path d="M12 7.5v5.5M12 16.5h.01" /></svg>
    </div>
    <h4>Something went wrong</h4>
    <p>An error occurred while processing your request. Please try again.</p>
    <a class="btn btn-sm btn-ink mt-3" href="/">Back to home</a>
</div>
